---
// The frame shared by every page: <head> tags for search and sharing, header, footer.
import '../styles/global.css';
import Header, { type NavKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { seo } from '../data/seo';
import { googleSiteVerification, business, contact, activeSocial } from '../data/site';

interface Props {
  path: string; // the page's clean address, e.g. '/about'
  title?: string;
  description?: string;
  current?: NavKey;
  cta?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
}
const { path, current = '', cta = true, ogType = 'website', jsonLd = [] } = Astro.props;
const meta = seo[path] ?? { title: '', description: '' };
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const site = Astro.site!;
const canonical = new URL(path, site).href.replace(/\/$/, '') || site.href;
const ogImage = new URL('/og-image.png', site).href;

// Only the real production site may appear in Google. Vercel preview builds get noindex.
const isProduction = !process.env.VERCEL_ENV || process.env.VERCEL_ENV === 'production';
const noindex = Astro.props.noindex || !isProduction;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#organization', site).href,
  name: business.name,
  ...(business.legalName ? { legalName: business.legalName } : {}),
  url: site.href,
  logo: new URL('/icon-512.png', site).href,
  image: ogImage,
  slogan: business.tagline,
  areaServed: { '@type': 'Country', name: 'Pakistan' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.city,
    addressCountry: 'PK',
    ...(contact.address ? { streetAddress: contact.address } : {}),
  },
  ...(contact.phone ? { telephone: contact.phone } : {}),
  ...(contact.email ? { email: contact.email } : {}),
  ...(business.foundedYear ? { foundingDate: String(business.foundedYear) } : {}),
  ...(activeSocial.length ? { sameAs: activeSocial.map((s) => s.url) } : {}),
};
const ld = path === '/' ? [orgLd, ...jsonLd] : jsonLd;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
  <meta name="theme-color" content="#0B1F3A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/sora-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Paiwasta Technologies" />
  <meta property="og:locale" content="en_PK" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Paiwasta Technologies. Connected solutions. One team." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script is:inline>document.documentElement.classList.add('js');</script>
  <slot name="head" />
  {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <Header current={current} />
  <slot name="before-main" />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer cta={cta} />
  <script>
    // Gentle reveal-on-scroll for content below the first screen.
    const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!RM && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll<HTMLElement>('[data-reveal],[data-draw]').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < innerHeight * 0.92 && r.bottom > 0) return;
        el.classList.add('rv-wait'); io.observe(el);
      });
    }
  </script>
</body>
</html>
<style>
  main:focus { outline: none; }
</style>
