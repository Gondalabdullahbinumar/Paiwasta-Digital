---
// One template for all five service pages (web-development, software-development, ...).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { services, byKey, serviceHref, packages, type Service } from '../data/site';
import { seo } from '../data/seo';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const path = `/${s.slug}`;
const lower = s.name.toLowerCase().replace('ai ', 'AI ');
const pkg = packages.find((p) => p.id === s.pkg)!;
const site = Astro.site!;
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  description: seo[path].description,
  url: new URL(path, site).href,
  provider: { '@id': new URL('/#organization', site).href, '@type': 'ProfessionalService', name: 'Paiwasta Technologies', url: site.href },
  areaServed: { '@type': 'Country', name: 'Pakistan' },
  ...(s.minPrice ? { offers: { '@type': 'Offer', priceCurrency: 'PKR', price: s.minPrice, priceSpecification: { '@type': 'PriceSpecification', minPrice: s.minPrice, priceCurrency: 'PKR' } } } : {}),
};
---
<Base path={path} current="services" jsonLd={[serviceLd]}>
  <PageHero title={s.name} intro={s.promise} kicker={`Service ${s.n}`} parent={{ name: 'Services', href: '/services' }} />

  <section aria-labelledby="ex-h" class="section">
    <div class="container ex-grid">
      <div><p class="eyebrow">In plain words</p><h2 id="ex-h" class="h2">What {lower} means for your business</h2></div>
      <div data-reveal class="ex-body">{s.explain.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section aria-labelledby="dl-h" class="section no-top">
    <div class="container">
      <h2 id="dl-h" class="dl-h">What we deliver</h2>
      <ul class="deliver">
        {s.deliver.map((d) => (
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0E9F6E" stroke-width="1.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>{d}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="ln-h" class="section navy">
    <div class="container">
      <p class="eyebrow">Interlinked</p>
      <h2 id="ln-h" class="h2 ln-h">How {lower} links to the other four services</h2>
      <div class="grid-auto" style="--min:260px">
        {s.links.map((l) => (
          <a href={serviceHref(byKey[l.to])} class="card blueprint link-card" data-reveal>
            <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
            <span class="link-name"><span aria-hidden="true"></span>{byKey[l.to].name}</span>
            <p>{l.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="st-h" class="section">
    <div class="container">
      <h2 id="st-h" class="h2 st-h">The steps</h2>
      <ol class="steps">
        {s.steps.map(([t, d], i) => (
          <li data-reveal>
            <span class="step-dot" aria-hidden="true"></span>
            <p class="step-n">STEP 0{i + 1}</p>
            <h3>{t}</h3>
            <p class="step-d">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="pr-h" class="section no-top">
    <div class="container grid-auto" style="--min:360px; gap:32px">
      <div class="card blueprint pad">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <h2 id="pr-h" class="pr-h">Starting prices</h2>
        <p class="small">Starting prices in Pakistani rupees. Your final quote follows a free discovery call.</p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">Service</th><th scope="col">Price</th></tr></thead>
            <tbody>{s.prices.map(([a, b]) => <tr><td>{a}</td><td class="price">{b}</td></tr>)}</tbody>
          </table>
        </div>
        <a href="/pricing" class="text-link">See all prices and Care plans</a>
      </div>
      <div class="card blueprint pad pkg-card">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <span class="card-kicker">The package that includes it</span>
        <h3 class="pkg-name">{pkg.name}</h3>
        <p class="pkg-price">{pkg.from}</p>
        {pkg.extra && <p class="pkg-extra">{pkg.extra}</p>}
        <p class="m0">{pkg.summary} {pkg.suits}</p>
        <p class="small m0">Timeline: {pkg.timeline}</p>
        <div class="pkg-actions">
          <a class="btn btn-primary" href="/contact">Book a free consultation</a>
          <a href="/pricing" class="text-link">Compare packages</a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="sf-h" class="section no-top">
    <div class="container faq-grid faq-layout">
      <div><h2 id="sf-h" class="h2 sf-h">Questions about {lower}</h2><a href="/faq" class="text-link">All questions</a></div>
      <div class="faq-col"><Faq items={s.faqs} /></div>
    </div>
  </section>

  <nav aria-label="Other services" class="section no-top">
    <div class="container others">
      <p class="eyebrow">Other services</p>
      <ul>
        {services.filter((o) => o.key !== s.key).map((o) => <li><a href={serviceHref(o)}>{o.name}</a></li>)}
      </ul>
    </div>
  </nav>
</Base>

<style>
  .ex-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 40px 72px; }
  .ex-body { font-size: 17px; }
  .ex-body p { margin: 0 0 18px; }
  .dl-h { margin: 0 0 32px; font-size: clamp(26px, 3vw, 36px); }
  .deliver { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); border-top: 1px solid var(--color-divider); column-gap: 24px; }
  .deliver li { display: flex; gap: 14px; align-items: flex-start; padding: 18px 16px 18px 0; border-bottom: 1px solid var(--color-divider); }
  .deliver svg { flex-shrink: 0; margin-top: 3px; }
  .ln-h { margin: 0 0 40px; max-width: 24ch; }
  .link-card { color: #F7F9FB; }
  .link-card:hover { border-color: #0E9F6E; background: rgba(14,159,110,.07); color: #F7F9FB; }
  .link-name { display: flex; align-items: center; gap: 10px; font: 600 12px/1.3 var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: #3FCF9A; }
  .link-name span { width: 24px; height: 1px; background: #0E9F6E; flex-shrink: 0; }
  .link-card p { margin: 0; font-size: 16px; color: rgba(247,249,251,.86); }
  .st-h { margin: 0 0 48px; }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 32px 20px; }
  .steps li { position: relative; padding-top: 26px; border-top: 1px solid #0E9F6E; }
  .step-dot { position: absolute; top: -6px; left: 0; width: 11px; height: 11px; border-radius: 50%; background: #F7F9FB; border: 1px solid #0E9F6E; }
  .step-n { margin: 0 0 8px; font: 600 12px/1 var(--font-body); letter-spacing: .14em; color: #0A7A55; }
  .steps h3 { margin: 0 0 8px; font-size: 20px; }
  .step-d { margin: 0; font-size: 15px; }
  .pad { padding: clamp(24px, 3vw, 36px); }
  .pr-h { margin: 0 0 8px; font-size: clamp(24px, 2.6vw, 32px); }
  .small { margin: 0 0 16px; font-size: 14px; }
  .m0 { margin: 0; }
  .price { font-weight: 600; color: #0B1F3A; }
  .pkg-card { border-color: #0E9F6E; }
  .pkg-name { margin: 0; font-size: 28px; }
  .pkg-price { margin: 0; font: 600 24px/1.2 var(--font-heading); color: #0B1F3A; }
  .pkg-extra { margin: 0; font-size: 14px; color: #0A7A55; }
  .pkg-actions { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin-top: 8px; }
  .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 32px 64px; }
  .sf-h { margin: 0 0 8px; }
  .faq-col { min-width: 0; max-width: 820px; }
  .others { border-top: 1px solid var(--color-divider); padding-top: 32px; }
  .others ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0 28px; }
  .others a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
</style>
