---
// Case study template. Pages are created only for case studies with clientApproved: true.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { byKey, serviceHref } from '../../data/site';

export async function getStaticPaths() {
  const cases = (await getCollection('caseStudies', (c) => c.data.clientApproved)).sort((a, b) => a.data.order - b.data.order);
  return cases.map((c, i) => ({ params: { slug: c.id }, props: { c, next: cases[(i + 1) % cases.length] } }));
}
const { c, next } = Astro.props as { c: CollectionEntry<'caseStudies'>; next: CollectionEntry<'caseStudies'> };
const { Content } = await render(c);
const d = c.data;
---
<Base path={`/work/${c.id}`} current="work" title={`Case study: ${d.client} | Paiwasta Technologies`} description={d.summary.slice(0, 155)}>
  <PageHero kicker={`Case study · ${d.industry}`} title={d.client} intro={d.summary} crumb={d.client} parent={{ name: 'Work', href: '/work' }} />
  <section aria-label="Project details" class="details">
    <dl class="container dl">
      <div><dt>Client</dt><dd>{d.client}</dd></div>
      <div><dt>Industry</dt><dd>{d.industry}</dd></div>
      <div><dt>Services used</dt><dd class="tags">{d.services.map((k) => <a class="tag tag-accent" href={serviceHref(byKey[k])}>{byKey[k].name}</a>)}</dd></div>
      {d.timeline && <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>}
    </dl>
  </section>
  <article class="section prose-wrap"><div class="prose"><Content /></div></article>
  {d.results.length > 0 && (
    <section aria-labelledby="rs-h" class="section no-top">
      <div class="container">
        <h2 id="rs-h" class="h2 rs-h">Results</h2>
        <div class="results">{d.results.map((r) => <div><p class="fig">{r.figure}</p><p>{r.label}</p></div>)}</div>
      </div>
    </section>
  )}
  {d.quote && (
    <section aria-label="Client quote" class="section no-top">
      <figure class="quote">
        <blockquote>{d.quote.text}</blockquote>
        <figcaption>{d.quote.name}, {d.quote.role}</figcaption>
      </figure>
    </section>
  )}
  {next.id !== c.id && (
    <section aria-label="Next case study" class="section no-top">
      <a href={`/work/${next.id}`} class="blueprint container next">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <span><span class="next-k">Next case study · {next.data.industry}</span><span class="next-t">{next.data.title}</span></span>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0E9F6E" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </section>
  )}
</Base>
<style>
  .details { border-bottom: 1px solid var(--color-divider); padding: 28px var(--gutter); }
  .dl { margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 16px 32px; }
  dt { font: 600 12px var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: #0A7A55; }
  dd { margin: 4px 0 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .prose { max-width: 820px; margin: 0 auto; font-size: 17px; }
  .prose :global(h2) { font-size: clamp(28px, 3.4vw, 42px); margin: 48px 0 16px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 22px; margin: 28px 0 10px; }
  .rs-h { margin: 0 0 40px; }
  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); border-top: 1px solid var(--color-divider); border-left: 1px solid var(--color-divider); }
  .results > div { padding: 28px; border-right: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider); }
  .results p { margin: 0; }
  .fig { margin: 0 0 8px !important; font: 600 40px/1 var(--font-heading); color: #0B1F3A; }
  .quote { max-width: 900px; margin: 0 auto; padding-left: clamp(20px, 4vw, 48px); border-left: 1px solid #0E9F6E; }
  blockquote { margin: 0 0 20px; font: 600 clamp(22px, 2.6vw, 30px)/1.45 var(--font-heading); color: #0B1F3A; }
  figcaption { font-size: 15px; }
  .next { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding: clamp(24px, 4vw, 40px); text-decoration: none; color: inherit; }
  .next:hover { border-color: #0E9F6E; }
  .next-k { display: block; font: 600 12px var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: #0A7A55; margin-bottom: 8px; }
  .next-t { font: 600 clamp(20px, 2.4vw, 28px)/1.3 var(--font-heading); color: #0B1F3A; }
</style>
