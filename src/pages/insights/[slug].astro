---
// Article template. One page per Markdown file in src/content/articles/.
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { features } from '../../data/site';

export async function getStaticPaths() {
  const all = await getCollection('articles', (a) => !a.data.draft);
  return all.map((a) => ({ params: { slug: a.id }, props: { a, all } }));
}
const { a, all } = Astro.props as { a: CollectionEntry<'articles'>; all: CollectionEntry<'articles'>[] };
const { Content } = await render(a);
const d = a.data;
const path = `/insights/${a.id}`;
const site = Astro.site!;
const related = all.filter((x) => x.id !== a.id).sort((x, y) => Number(y.data.category === d.category) - Number(x.data.category === d.category)).slice(0, 3);
const author = d.author ?? 'Paiwasta Technologies team';
const fmt = (dt?: Date) => dt?.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(path, site).href;
const share = encodeURIComponent(url), shareTitle = encodeURIComponent(d.title);
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: d.title, description: d.description, mainEntityOfPage: url,
  image: new URL('/og-image.png', site).href,
  ...(d.date ? { datePublished: d.date.toISOString().slice(0, 10) } : {}),
  author: d.author ? { '@type': 'Person', name: d.author } : { '@type': 'Organization', name: 'Paiwasta Technologies', url: site.href },
  publisher: { '@type': 'Organization', name: 'Paiwasta Technologies', logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site).href } },
};
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
  { '@type': 'ListItem', position: 2, name: 'Insights', item: new URL('/insights', site).href },
  { '@type': 'ListItem', position: 3, name: d.title, item: url },
] };
---
<Base path={path} current="insights" title={`${d.title} | Paiwasta`} description={d.description} ogType="article" noindex={!features.insights} jsonLd={[articleLd, crumbLd]}>
  <header class="a-hero navy">
    <div class="a-wrap">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li aria-hidden="true" class="sep">/</li><li><a href="/insights">Insights</a></li><li aria-hidden="true" class="sep">/</li><li aria-current="page" class="cur">Article</li></ol></nav>
      <p class="meta"><span class="cat">{d.category}</span>{d.date && <time datetime={d.date.toISOString().slice(0, 10)}>{fmt(d.date)}</time>}<span>{d.minutes} min read</span></p>
      <h1>{d.title}</h1>
    </div>
  </header>
  <article class="a-body"><div class="prose"><Content /></div>
    <div class="prose">
      <div class="share">
        <span class="share-h">Share this article</span>
        <a href={`https://wa.me/?text=${shareTitle}%20${share}`} target="_blank" rel="noopener" class="btn btn-secondary">WhatsApp</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} target="_blank" rel="noopener" class="btn btn-secondary">LinkedIn</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener" class="btn btn-secondary">Facebook</a>
        <a href={`mailto:?subject=${shareTitle}&body=${share}`} class="btn btn-secondary">Email</a>
      </div>
      <aside aria-label="About the author" class="blueprint author">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <p class="au-name">{author}</p>
        <p class="m0">{d.authorBio ?? 'The Paiwasta Technologies team designs, builds and automates online presences for businesses in Pakistan.'}</p>
      </aside>
    </div>
  </article>
  {related.length > 0 && (
    <section aria-labelledby="rel-h" class="section no-top">
      <div class="container">
        <h2 id="rel-h" class="rel-h">Related articles</h2>
        <div class="grid-auto">
          {related.map((r) => (
            <a href={`/insights/${r.id}`} class="card blueprint">
              <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
              <span class="card-kicker">{r.data.category} · {r.data.minutes} min read</span>
              <h3 class="card-title">{r.data.title}</h3>
              <p class="card-body">{r.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .a-hero { padding: calc(var(--header-h) + clamp(52px, 8vw, 100px)) var(--gutter) clamp(48px, 6vw, 80px); }
  .a-wrap { max-width: 820px; margin: 0 auto; }
  .crumbs { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-wrap: wrap; gap: 0 8px; font-size: 13.5px; color: #A9BCD0; }
  .crumbs a { color: #A9BCD0; display: inline-flex; align-items: center; min-height: 44px; }
  .crumbs .sep { color: #0E9F6E; display: flex; align-items: center; }
  .crumbs .cur { color: #F7F9FB; display: flex; align-items: center; }
  .meta { margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 14px; color: #C3D1DE; align-items: baseline; }
  .cat { color: #3FCF9A; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; font-size: 12px; }
  h1 { margin: 0; color: #F7F9FB; font-size: clamp(32px, 5vw, 56px); line-height: 1.1; }
  .a-body { padding: clamp(48px, 6vw, 80px) var(--gutter); }
  .prose { max-width: 720px; margin: 0 auto; font-size: 18px; line-height: 1.75; }
  .prose :global(.lede) { font-size: 20px; color: #0B1F3A; margin: 0 0 24px; }
  .prose :global(h2) { margin: 48px 0 16px; font-size: clamp(24px, 2.8vw, 32px); }
  .prose :global(h3) { margin: 32px 0 12px; font-size: 22px; }
  .prose :global(p) { margin: 0 0 20px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 24px; padding-left: 24px; display: flex; flex-direction: column; gap: 10px; }
  .prose :global(blockquote) { margin: 40px 0; padding: 8px 0 8px 28px; border-left: 1px solid #0E9F6E; font: 600 clamp(20px, 2.4vw, 26px)/1.5 var(--font-heading); color: #0B1F3A; }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 15px; margin: 0 0 24px; border: 1px solid var(--color-divider); }
  .prose :global(td), .prose :global(th) { min-width: 140px; }
  .prose :global(th), .prose :global(td) { padding: 12px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-divider); }
  .prose :global(th) { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .prose :global(.table-wrap) { overflow-x: auto; margin: 0 0 24px; border: 1px solid var(--color-divider); }
  .prose :global(.rings-figure) { margin: 40px 0; }
  .prose :global(.rings-fig-bg) { background: #0B1F3A; padding: clamp(24px, 5vw, 56px); }
  .prose :global(.rings-fig-bg svg) { display: block; overflow: visible; }
  .prose :global(figcaption) { padding: 12px 16px; font-size: 14px; }
  .share { margin: 56px 0 0; padding-top: 24px; border-top: 1px solid var(--color-divider); display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
  .share-h { font-weight: 600; color: #0B1F3A; }
  .author { margin: 40px 0 0; padding: 24px; font-size: 16px; }
  .au-name { margin: 0 0 4px; font: 600 18px var(--font-heading); color: #0B1F3A; }
  .m0 { margin: 0; }
  .rel-h { margin: 0 0 32px; font-size: clamp(26px, 3vw, 36px); }
</style>
