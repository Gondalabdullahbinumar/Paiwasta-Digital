---
import Base from '../layouts/Base.astro';
import Rings from '../components/Rings.astro';
import { features } from '../data/site';
const links = [['Services', '/services'], ['Pricing', '/pricing'], ['Work', '/work'], ['About', '/about'], ...(features.insights ? [['Insights', '/insights']] : []), ['FAQ', '/faq'], ['Contact', '/contact']];
---
<Base path="/404" cta={false} noindex>
  <section class="nf navy">
    <div class="wrap">
      <div class="rings"><Rings drift max="520px" /></div>
      <p class="eyebrow">Error 404</p>
      <h1>This link has come loose</h1>
      <p class="lead">The page you were looking for has moved or does not exist. These pages will take you back.</p>
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <nav aria-label="Main pages" class="links">{links.map(([l, h]) => <a href={h}>{l}</a>)}</nav>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100vh; min-height: 100svh; padding: calc(var(--header-h) + clamp(64px, 10vw, 124px)) var(--gutter) clamp(80px, 10vw, 120px);
    background-image: linear-gradient(rgba(247,249,251,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(247,249,251,.04) 1px, transparent 1px); background-size: 64px 64px; }
  .wrap { max-width: 900px; margin: 0 auto; text-align: center; }
  .rings { max-width: 520px; margin: 0 auto 48px; padding-right: 16%; }
  .rings :global(svg) { margin: 0 auto; }
  .eyebrow { margin-bottom: 14px; }
  h1 { margin: 0 0 18px; color: #F7F9FB; font-size: clamp(32px, 5vw, 56px); line-height: 1.1; }
  .lead { margin: 0 auto 32px; max-width: 52ch; font-size: 18px; color: rgba(247,249,251,.84); }
  .links { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 24px; }
  .links a { color: #3FCF9A; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 4px; }
</style>
