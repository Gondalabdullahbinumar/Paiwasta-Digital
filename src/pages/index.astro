---
import Base from '../layouts/Base.astro';
import Rings from '../components/Rings.astro';
import Faq from '../components/Faq.astro';
import { getCollection } from 'astro:content';
import { business, services, serviceHref, byKey, packages, processSteps, storyLinks, flow, faqs } from '../data/site';

const cases = (await getCollection('caseStudies', (c) => c.data.clientApproved))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const faqItems: [string, string][] = [faqs.services.items[0], faqs.pricing.items[0], faqs.timelines.items[0], faqs.services.items[2]];
const pkgLabel = (k: string) => byKey[k as keyof typeof byKey].name;
---
<Base path="/" current="home">
  <script is:inline slot="head">
    // Decide before the page draws whether the 3D story can run. If not (no WebGL,
    // or the visitor prefers reduced motion), the static linked-rings version shows instead.
    (function () {
      try {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('WebGLRenderingContext' in window)) return;
        document.documentElement.classList.add('pw-3d');
      } catch (e) {}
    })();
  </script>

  <Fragment slot="before-main">
    <div class="stage" aria-hidden="true" data-stage data-links={JSON.stringify(storyLinks.map((l) => [l[0], l[1]]))} data-slugs={JSON.stringify(Object.fromEntries(services.map((s) => [s.key, s.slug])))}></div>
    <div class="tip" role="status" data-tip hidden><span data-tip-name></span><span class="tip-hint" data-tip-hint></span></div>
  </Fragment>

  <section class="story navy" aria-labelledby="hero-h" data-story>
    <div class="story-sticky">
      <div class="hero-copy" data-hero>
        <p class="eyebrow">Paiwasta Technologies</p>
        <h1 id="hero-h">Five services. One connected team.</h1>
        <p class="hero-lead">We design, build and automate your whole online presence: brand, website, software, video and AI assistants, run by one accountable team.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/contact">Book a free consultation</a>
          <a href="/services" class="hero-link">Explore the five services</a>
        </div>
        <button type="button" class="scroll-hint" data-next><span aria-hidden="true"></span>Scroll to see how they connect</button>
      </div>
      <div class="story-side">
        <div class="side-rings"><Rings max="520px" label="Illustration: five rings linked into one chain" /></div>
        <div class="caps" data-caps>
          <ol class="cap-list">
            {storyLinks.map(([a, b, text], i) => (
              <li class="cap" data-cap={i}>
                <span class="cap-n">0{i + 1}</span>
                <span class="cap-body">
                  <span class="cap-meta">Link {i + 1} of 5 · {pkgLabel(a)} and {pkgLabel(b)}</span>
                  <span class="cap-text">{text}</span>
                </span>
              </li>
            ))}
          </ol>
          <div class="cap-dots" aria-hidden="true">{storyLinks.map((_, i) => <span data-dot={i}></span>)}</div>
        </div>
        <div class="join" data-join>
          <p class="eyebrow join-eyebrow">The joining</p>
          <h2 class="join-text">This is Paiwasta. Joined so closely it does not come apart.</h2>
        </div>
      </div>
    </div>
  </section>

  <div class="after">
    {business.registrations.length > 0 && (
      <section aria-label="Registration" class="trust">
        <div class="container trust-grid">
          <p class="trust-h">Registered and accountable</p>
          {business.registrations.map((r) => <p>{r}</p>)}
        </div>
      </section>
    )}

    <section aria-labelledby="svc-h" class="section">
      <div class="container">
        <div class="svc-head" data-reveal>
          <div><p class="eyebrow">What we do</p><h2 id="svc-h" class="h2-lg">Five services, built to work together</h2></div>
          <p class="svc-intro">Each service stands on its own. Hover or focus a service to see which others it connects to.</p>
        </div>
        <div class="svc-grid" data-svc-grid>
          {services.map((s) => (
            <a href={serviceHref(s)} class="card blueprint svc-card" data-reveal data-key={s.key} data-links={s.links.map((l) => l.to).join(' ')} data-name={s.name}>
              <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
              <div class="svc-top"><span class="card-kicker">{s.n}</span><span class="svc-dot" aria-hidden="true"></span></div>
              <h3 class="card-title">{s.name}</h3>
              <p class="card-body">{s.short}</p>
              <p class="svc-rel" aria-hidden="true" data-rel></p>
              <span class="svc-more">View service</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="why-h" class="section navy">
      <div class="container">
        <p class="eyebrow">Why one team</p>
        <h2 id="why-h" class="h2-lg why-h" data-reveal>Five separate vendors, or one team that owns the result</h2>
        <div class="grid-auto" style="--min:340px">
          <div class="why-bad" data-reveal>
            <h3>Five separate vendors</h3>
            <ul>
              <li>Five contracts, five invoices and five people to chase.</li>
              <li>The designer, developer and video editor rarely speak to each other.</li>
              <li>Your brand looks slightly different on every platform.</li>
              <li>When something breaks, each vendor points to another.</li>
              <li>You spend your time coordinating instead of running your business.</li>
            </ul>
          </div>
          <div class="blueprint why-good" data-reveal>
            <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
            <h3>Paiwasta</h3>
            <ul>
              <li>One agreement, one invoice schedule and one named contact.</li>
              <li>Design, web, software, video and AI are planned together from the start.</li>
              <li>Every piece follows the same brand and the same plan.</li>
              <li>One team is accountable for the whole result, after launch as well.</li>
              <li>You make decisions; we handle the coordination.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="flow-h" class="section">
      <div class="container">
        <p class="eyebrow">How the services connect</p>
        <h2 id="flow-h" class="h2-lg flow-h" data-reveal>Each step builds on the one before it</h2>
        <ol class="steps">
          {flow.map(([t, d], i) => (
            <li data-reveal>
              <span class="step-dot" aria-hidden="true"></span>
              <p class="step-n">STEP 0{i + 1}</p>
              <h3>{t}</h3>
              <p class="step-d">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="draw-wrap" aria-hidden="true"><span data-draw class="draw"></span></div>

    <section aria-labelledby="pkg-h" class="section pkg-section">
      <div class="container">
        <div class="head-row" data-reveal>
          <div><p class="eyebrow">Packages</p><h2 id="pkg-h" class="h2-lg">Three ways to start</h2></div>
          <a href="/pricing" class="text-link">See full pricing and Care plans</a>
        </div>
        <div class="grid-auto">
          {packages.map((p) => (
            <article class="card blueprint pkg" data-reveal style={p.featured ? 'border-color:#0E9F6E' : ''}>
              <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
              <span class="card-kicker">{p.timeline}</span>
              <h3 class="card-title pkg-name">{p.name}</h3>
              <p class="pkg-price">{p.from}</p>
              {p.extra && <p class="pkg-extra">{p.extra}</p>}
              <p class="card-body">{p.summary}</p>
              <p class="pkg-for"><strong>For:</strong> {p.suits}</p>
              <a href="/pricing" class="text-link pkg-link">What is included in {p.name}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="proc-h" class="section navy">
      <div class="container">
        <div class="head-row proc-head" data-reveal>
          <div><p class="eyebrow">Process</p><h2 id="proc-h" class="h2-lg">Six clear steps, from first call to ongoing care</h2></div>
          <a href="/process" class="text-link">See the full process</a>
        </div>
        <ol class="proc-grid">
          {processSteps.map((s, i) => (
            <li data-reveal>
              <p class="proc-n">0{i + 1}</p>
              <h3>{s.name}</h3>
              <p>{s.brief}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {cases.length > 0 && (
      <section aria-labelledby="work-h" class="section">
        <div class="container">
          <div class="head-row" data-reveal>
            <div><p class="eyebrow">Selected work</p><h2 id="work-h" class="h2-lg">Projects where the pieces work together</h2></div>
            <a href="/work" class="text-link">View all work</a>
          </div>
          <div class="grid-auto">
            {cases.map((c) => (
              <a href={`/work/${c.id}`} class="card blueprint" data-reveal>
                <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
                <span class="card-kicker">{c.data.industry} · {c.data.services.map((k) => byKey[k].name).join(', ')}</span>
                <h3 class="card-title">{c.data.title}</h3>
                <p class="card-body">{c.data.summary}</p>
                <span class="svc-more">Read the case study</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section aria-labelledby="name-h" class="section navy name-sec">
      <div class="container name-grid">
        <p lang="ur" dir="rtl" class="name-urdu" data-reveal>پیوستہ</p>
        <div data-reveal>
          <p class="eyebrow gold">The meaning of the name</p>
          <h2 id="name-h" class="h2-lg name-h">Paiwasta: joined so closely the parts do not come apart</h2>
          <p class="muted-navy">Paiwasta (<span lang="ur" dir="rtl">پیوستہ</span>) is an Urdu word for things that are joined so closely they hold as one. We chose it because it describes how we work: your brand, website, software, videos and AI assistants are planned and built as one connected whole.</p>
          <a href="/about" class="text-link">About Paiwasta</a>
        </div>
      </div>
    </section>

    <section aria-labelledby="faq-h" class="section">
      <div class="container faq-wrap faq-layout">
        <div>
          <p class="eyebrow">Questions</p>
          <h2 id="faq-h" class="h2-lg faq-h">Common questions</h2>
          <a href="/faq" class="text-link">Read all questions</a>
        </div>
        <div class="faq-col"><Faq items={faqItems} /></div>
      </div>
    </section>
  </div>
</Base>

<script>
  const root = document.documentElement;
  const story = document.querySelector<HTMLElement>('[data-story]')!;
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const caps = [...document.querySelectorAll<HTMLElement>('[data-cap]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  const tip = document.querySelector<HTMLElement>('[data-tip]')!;
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

  // ─── Service cards: hovering or focusing a card lights up the services it connects to.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-svc-grid] [data-key]')];
  const clear = () => cards.forEach((c) => { c.classList.remove('on', 'rel'); c.querySelector('[data-rel]')!.textContent = ''; });
  cards.forEach((card) => {
    const light = () => {
      clear();
      const rel = card.dataset.links!.split(' ');
      card.classList.add('on');
      card.querySelector('[data-rel]')!.textContent = `Connects to ${rel.length} services`;
      cards.forEach((c) => { if (rel.includes(c.dataset.key!)) { c.classList.add('rel'); c.querySelector('[data-rel]')!.textContent = `Linked to ${card.dataset.name}`; } });
    };
    card.addEventListener('mouseenter', light);
    card.addEventListener('focus', light);
    card.addEventListener('blur', clear);
  });
  document.querySelector('[data-svc-grid]')?.addEventListener('mouseleave', clear);

  // ─── 3D story
  if (root.classList.contains('pw-3d')) {
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a), 0, 1);
    const progress = () => { const r = story.getBoundingClientRect(); const span = r.height - innerHeight; return span > 0 ? clamp(-r.top / span, 0, 1) : 0; };
    let lastP = -1;
    const update = () => {
      const p = progress(); if (Math.abs(p - lastP) < 0.002) return; lastP = p;
      const h = seg(p, 0.03, 0.09);
      story.style.setProperty('--hero-op', String(1 - h));
      story.style.setProperty('--hero-y', `${-40 * h}px`);
      story.classList.toggle('hero-off', p >= 0.06);
      const ci = clamp(Math.floor((p - 0.12) / 0.1), 0, 4);
      story.classList.toggle('cap-on', p > 0.11 && p < 0.6);
      caps.forEach((c, i) => c.classList.toggle('active', i === ci));
      dots.forEach((d, i) => d.classList.toggle('done', i <= ci));
      story.classList.toggle('join-on', p > 0.66 && p < 0.86);
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', () => { lastP = -1; update(); });
    update();

    // "Scroll to see how they connect" moves to the first link stage.
    document.querySelector('[data-next]')?.addEventListener('click', () => {
      const top = story.getBoundingClientRect().top + scrollY;
      scrollTo({ top: top + (story.offsetHeight - innerHeight) * 0.18, behavior: 'smooth' });
    });

    const toStatic = () => { root.classList.remove('pw-3d'); story.removeAttribute('style'); };
    // Phones and low-power devices get the lighter scene: fewer particles, no bloom.
    const nav = navigator as Navigator & { deviceMemory?: number };
    const lite = innerWidth < 768 || (navigator.hardwareConcurrency || 8) <= 4 || (nav.deviceMemory || 8) <= 4;
    const hoverHint = matchMedia('(hover: none)').matches ? 'Tap again to open' : 'Click to open';
    const start = () => {
      // Confirm WebGL really works before loading three.js.
      let ok = false;
      try { const c = document.createElement('canvas'); ok = !!(c.getContext('webgl2') || c.getContext('webgl')); } catch (e) {}
      if (!ok) return toStatic();
      import('../scripts/home3d.js').then((m) => m.init({
        mount: stage, story, lite,
        links: JSON.parse(stage.dataset.links!),
        onHover: (hv: { name: string; x: number; y: number } | null) => {
          if (!hv) { tip.hidden = true; return; }
          tip.hidden = false;
          tip.style.left = `${Math.round(hv.x)}px`; tip.style.top = `${Math.round(Math.max(84, hv.y))}px`;
          tip.querySelector('[data-tip-name]')!.textContent = hv.name;
          tip.querySelector('[data-tip-hint]')!.textContent = hoverHint;
        },
        onPick: (k: string) => { const slug = JSON.parse(stage.dataset.slugs!)[k]; if (slug) location.href = `/${slug}`; },
      })).catch((e) => { console.warn('3D unavailable', e); toStatic(); stage.remove(); });
    };
    // Show the text first; load the 3D scene once the page has finished loading and the browser is idle.
    const go = () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1200 }) : start()), 250);
    if (document.readyState === 'complete') go(); else addEventListener('load', go, { once: true });
  } else {
    stage.remove();
  }
</script>

<style>
  /* ── Static version (default; also the fallback without WebGL or with reduced motion) ── */
  .stage { display: none; }
  .story {
    position: relative;
    padding: calc(var(--header-h) + clamp(52px, 10vw, 104px)) var(--gutter) clamp(64px, 8vw, 104px);
    overflow: hidden;
    background-image: linear-gradient(rgba(247,249,251,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(247,249,251,.04) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .story-sticky { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 48px; align-items: center; }
  .hero-copy { min-width: 0; }
  .eyebrow { color: #3FCF9A; }
  .hero-copy .eyebrow { margin-bottom: 18px; letter-spacing: .18em; }
  h1 { margin: 0 0 18px; color: #F7F9FB; font-size: clamp(38px, 6vw, 76px); line-height: 1.04; max-width: 13ch; }
  .hero-lead { margin: 0 0 28px; font-size: clamp(17px, 1.7vw, 21px); color: rgba(247,249,251,.86); max-width: 50ch; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .hero-link { display: inline-flex; align-items: center; min-height: 44px; color: #F7F9FB; font-weight: 500; }
  .hero-link:hover { color: #3FCF9A; }
  .scroll-hint { display: none; }
  .story-side { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  .cap-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .cap { display: flex; gap: 12px; color: rgba(247,249,251,.86); font-size: 15px; }
  .cap-n { color: #3FCF9A; font-weight: 600; }
  .cap-meta, .cap-dots { display: none; }
  .join-eyebrow { display: none; }
  .join-text { margin: 0; font: 600 20px/1.35 var(--font-heading); color: #F7F9FB; letter-spacing: -0.01em; }
  .tip { display: none; }

  /* ── 3D version ── */
  :global(.pw-3d) .stage { display: block; position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 0; overflow: hidden; background: #0B1F3A; }
  :global(.pw-3d) .story { height: 560vh; padding: 0; background: transparent; z-index: 1; pointer-events: none; overflow: visible; }
  :global(.pw-3d) .story-sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: block; max-width: none; }
  :global(.pw-3d) .hero-copy {
    position: absolute; inset: 0; max-width: 1320px; margin: 0 auto;
    padding: 96px clamp(20px, 5vw, 64px) calc(clamp(36px, 6vh, 72px) + var(--safe-b));
    display: flex; flex-direction: column; justify-content: flex-end;
    opacity: var(--hero-op, 1); transform: translateY(var(--hero-y, 0)); transition: opacity .35s ease;
  }
  :global(.pw-3d) h1 { font-size: clamp(38px, 6.4vw, 84px); text-shadow: 0 2px 24px rgba(11,31,58,.7); }
  :global(.pw-3d) .hero-lead { text-shadow: 0 1px 16px rgba(11,31,58,.9); }
  :global(.pw-3d) .hero-ctas, :global(.pw-3d) .scroll-hint { pointer-events: auto; }
  :global(.pw-3d) .hero-off .hero-ctas, :global(.pw-3d) .hero-off .scroll-hint { pointer-events: none; visibility: hidden; }
  :global(.pw-3d) .scroll-hint {
    display: flex; align-self: flex-start; align-items: center; gap: 12px; margin: clamp(20px, 5vh, 48px) 0 0; min-height: 44px; padding: 0;
    background: none; border: 0; cursor: pointer; text-align: left; font: 500 12px/1 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: #A9BCD0;
  }
  :global(.pw-3d) .scroll-hint:hover { color: #3FCF9A; }
  :global(.pw-3d) .scroll-hint span { width: 1px; height: 36px; background: linear-gradient(#0E9F6E, transparent); }
  :global(.pw-3d) .story-side { display: contents; }
  :global(.pw-3d) .side-rings { display: none; }
  :global(.pw-3d) .caps {
    position: absolute; left: clamp(20px, 5vw, 64px); right: clamp(20px, 5vw, 64px); bottom: calc(clamp(36px, 7vh, 80px) + var(--safe-b));
    max-width: 520px; opacity: 0; transition: opacity .35s ease;
  }
  :global(.pw-3d) .cap-on .caps { opacity: 1; }
  :global(.pw-3d) .cap-list { display: grid; padding: 22px 24px; background: rgba(11,31,58,.6); border: 1px solid rgba(14,159,110,.4); backdrop-filter: blur(10px); }
  :global(.pw-3d) .cap { grid-area: 1 / 1; opacity: 0; transition: opacity .3s ease; }
  :global(.pw-3d) .cap.active { opacity: 1; }
  :global(.pw-3d) .cap-n { display: none; }
  :global(.pw-3d) .cap-body { display: flex; flex-direction: column; }
  :global(.pw-3d) .cap-meta { display: block; margin: 0 0 10px; font: 600 12px/1.3 var(--font-body); letter-spacing: .16em; text-transform: uppercase; color: #3FCF9A; }
  :global(.pw-3d) .cap-text { font: 600 clamp(20px, 2.2vw, 26px)/1.3 var(--font-heading); color: #F7F9FB; }
  :global(.pw-3d) .cap-dots { display: flex; gap: 6px; margin-top: 14px; }
  :global(.pw-3d) .cap-dots span { height: 2px; flex: 1; background: rgba(247,249,251,.2); }
  :global(.pw-3d) .cap-dots span:global(.done) { background: #0E9F6E; }
  :global(.pw-3d) .join {
    position: absolute; left: 0; right: 0; top: clamp(96px, 16vh, 170px); padding: 0 clamp(20px, 5vw, 64px);
    text-align: center; opacity: 0; transition: opacity .4s ease;
  }
  :global(.pw-3d) .join-on .join { opacity: 1; }
  :global(.pw-3d) .join-eyebrow { display: block; margin-bottom: 14px; letter-spacing: .18em; }
  :global(.pw-3d) .join-text { margin: 0 auto; font-size: clamp(28px, 4.2vw, 54px); line-height: 1.12; max-width: 20ch; }
  :global(.pw-3d) .tip {
    display: block; position: fixed; transform: translateX(-50%); z-index: 45; pointer-events: none; padding: 8px 14px;
    background: rgba(11,31,58,.82); border: 1px solid #0E9F6E; backdrop-filter: blur(8px); color: #F7F9FB; font: 600 13.5px/1 var(--font-heading); white-space: nowrap;
  }
  :global(.pw-3d) .tip[hidden] { display: none; }
  .tip-hint { display: block; margin-top: 5px; font: 400 11.5px/1 var(--font-body); color: #A9BCD0; }

  /* ── Sections after the story ── */
  .after { position: relative; z-index: 2; background: #F7F9FB; }
  .trust { border-bottom: 1px solid var(--color-divider); padding: 28px var(--gutter); }
  .trust-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px 32px; font-size: 14px; }
  .trust-grid p { margin: 0; }
  .trust-h { font-weight: 600; color: #0B1F3A; }
  .svc-head { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 20px 48px; align-items: end; margin-bottom: 48px; }
  .svc-intro { margin: 0; max-width: 56ch; }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 20px; }
  .svc-card { min-height: 260px; }
  .svc-card:global(.on) { border-color: #0E9F6E; background: rgba(14,159,110,.07); }
