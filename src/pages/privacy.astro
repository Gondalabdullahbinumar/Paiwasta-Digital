---
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';
import { business, contact, displayName } from '../data/site';

const reach = [contact.email && `email <a href="mailto:${contact.email}">${contact.email}</a>`, contact.phone && `call ${contact.phone}`].filter(Boolean).join(' or ');
const sections = [
  { h: 'Who we are', p: [`This policy explains how ${displayName}, based in ${business.city}, ${business.country}, handles the personal information you share with us through this website, WhatsApp and email.`] },
  { h: 'Information we collect', p: [
    'When you fill in our consultation form, we receive your name, business name, phone number, email address, the service and budget range you choose, and your message.',
    'When you apply for a job, we receive your name, email address, phone number, the role, your portfolio link, your CV and your message.',
    'When you message us on WhatsApp or by email, we receive what you choose to send.',
    'This website does not use advertising or tracking cookies, and we do not run analytics tools on it.',
  ] },
  { h: 'How we use your information', p: ['We use it to reply to your enquiry, arrange a discovery call, prepare proposals, deliver and support the services you buy, and consider job applications. We do not sell your information, and we do not use it for unrelated marketing.'] },
  { h: 'Sharing your information', p: [
    'We use a small number of service providers to run this website and receive messages: Vercel hosts the website, Web3Forms delivers consultation requests to our email, FormSubmit delivers job applications to our email, and WhatsApp carries messages you send us there. They handle your information only to provide those services.',
    'We share information with anyone else only when the law requires it, or with your permission.',
  ] },
  { h: 'How long we keep information', p: ['We keep enquiries and client records only for as long as we need them to respond, deliver our services and keep proper business records. Job applications are kept only as long as needed to consider them. You can ask us to delete your information sooner.'] },
  { h: 'Cookies', p: ['This website does not set cookies for tracking or advertising. Your browser may store small technical items that the website needs to work, such as remembering your name for the thank-you message after you send the form.'] },
  { h: 'Your rights', p: ['You can ask us for a copy of the information we hold about you, ask us to correct it, or ask us to delete it. We will reply within a reasonable time.'] },
  { h: 'Contact', p: [reach ? `To ask about your information, ${reach}, or use our <a href="/contact">contact page</a>.` : 'To ask about your information, use our <a href="/contact">contact page</a>.'] },
];
---
<Base path="/privacy" noindex>
  <LegalPage title="Privacy Policy" intro="How we collect, use and protect the information you share with us." sections={sections} />
</Base>
